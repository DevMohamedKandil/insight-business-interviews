# Non-secret application defaults for firebase-functions/params (ADR-0020).
# Committed to source control on purpose — these are NOT secrets (the actual
# OPENROUTER_API_KEY stays in Secret Manager / .secret.local, never here).
#
# Root cause this file fixes: `defineString()` params with no .env entry and no
# CLI value cause the Firebase CLI to prompt interactively for a value. In a
# non-interactive process (background emulator, CI, GitHub Actions) there is no
# terminal to answer that prompt, so the param silently resolved to an empty
# string instead of the declared default — which broke generateProjectDraft
# (AIProviderFactory.resolve("") -> "No AI provider registered for key \"\"").
#
# This file is loaded automatically in ALL environments (local emulator, CI,
# and real deployments) — see .env.local for emulator-only overrides and
# .env.<projectId> for a specific project's overrides, neither of which are
# needed here since these values are the same everywhere for now.
AI_PROVIDER=openrouter
AI_MODEL=openai/gpt-4o-mini
