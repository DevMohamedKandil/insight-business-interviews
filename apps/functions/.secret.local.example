# Copy this file to `.secret.local` (same folder) and fill in your real key.
# `.secret.local` is gitignored — the Firebase Functions Emulator reads secrets
# defined via `defineSecret()` (see src/composition-root.ts) from this file when
# running locally, so `OPENROUTER_API_KEY` never needs to touch Secret Manager
# until a real deployment (Document 6 §8 / ADR-0010).
OPENROUTER_API_KEY=sk-or-v1-your-real-key-here
